   "locked": false,
   "text": "At-least-once delivery + idempotency + fencing = effectively-once side effects. Kill a worker: lose nothing, repeat nothing.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "At-least-once delivery + idempotency + fencing = effectively-once side effects. Kill a worker: lose nothing, repeat nothing.",
   "lineHeight": 1.25,
   "autoResize": true
  },
